# ─────────────────────────────────────────────────────────────
# WHI-SL Environment Variables
# Copy this file to .env.local and fill in the values.
# ─────────────────────────────────────────────────────────────

# ── Email (Contact & Partnership forms) ─────────────────────
# Option A: SMTP (recommended for Gmail, Outlook, etc.)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password

# Option B: Resend (alternative — uncomment if using Resend)
# RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Where form submissions are delivered
CONTACT_EMAIL=info@whi-sl.org

# ── AI Chatbot (OpenRouter) ─────────────────────────────────
# Falls back to search-based answers if not set.
OPENROUTER_API_KEY=sk-or-v1-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ── Next.js ─────────────────────────────────────────────────
# Already defaults to http://localhost:3000 locally.
# For production, set NEXT_PUBLIC_BASE_URL=https://whi-sl.org
NEXT_PUBLIC_BASE_URL=https://whi-sl.org
