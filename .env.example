# ─────────────────────────────────────────────────────────────
# WHI-SL Environment Variables
# Copy this file to .env.local and fill in the values.
# ─────────────────────────────────────────────────────────────

# ── Email (Contact & Partnership forms) ─────────────────────
# Option A: SMTP (recommended for Gmail, Outlook, etc.)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password

# Option B: Resend (alternative — uncomment if using Resend)
# RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Where form submissions are delivered
CONTACT_EMAIL=info@whi-sl.org

# ── AI Chatbot (OpenRouter) ─────────────────────────────────
# Falls back to search-based answers if not set.
OPENROUTER_API_KEY=sk-or-v1-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ── Next.js ─────────────────────────────────────────────────
# Already defaults to http://localhost:3000 locally.
# For production, set NEXT_PUBLIC_BASE_URL=https://whi-sl.org
NEXT_PUBLIC_BASE_URL=https://whi-sl.org

# ── Database ─────────────────────────────────────────────────
# Local dev (MongoDB running locally):
MONGODB_URI=mongodb://127.0.0.1:27017
MONGODB_DB=whi_sl

# MongoDB Atlas (production — set in Vercel dashboard):
# MONGODB_URI=mongodb+srv://mayintake351_db_user:YOUR_PASSWORD@cluster0.vywbjgd.mongodb.net/?retryWrites=true&w=majority
# MONGODB_DB=whi_sl

# ── Vercel Blob Storage (for image uploads) ──────────────────
# Required for partner logos and project images in production.
# Get your token from: https://vercel.com/dashboard → Storage → Blob
# Falls back to base64 data URLs stored in MongoDB if not set.
# BLOB_READ_WRITE_TOKEN=vercel_blob_xxxxxxxxxxxxxxxxxxxxxxxx

# Local dev (SQLite) — kept for Prisma admin / migrations:
DATABASE_URL="file:./prisma/dev.db"
