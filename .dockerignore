# Keep the Docker build context small.
# NOTE: public/ must stay included — it holds the runtime images.

node_modules
.next
.git
.gitignore
.vercel
.agents
.claude
.playwright-mcp

# Source-image folders — these ARE required: data/photo-assets.ts and
# app/team/page.tsx import from them at build time.
# otherimages, newimages  (must NOT be excluded)

# Docs / logs
*.md
*.docx
*.log

# Secrets and local databases — never bake these into an image
.env
.env.*
*.env
dev.db
prisma/dev.db
