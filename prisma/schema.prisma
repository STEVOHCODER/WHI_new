// Prisma schema — used by both local SQLite and Vercel PostgreSQL
// Local:  DATABASE_URL=file:./prisma/dev.db   (provider="sqlite" in prisma.config.ts)
// Vercel: DATABASE_URL=postgres://...          (provider="postgresql" in prisma.config.ts)
// The schema itself is compatible with both databases.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
}

model Project {
  id          String   @id @default(cuid())
  title       String
  slug        String   @unique
  excerpt     String
  content     String?
  imageUrl    String?
  gallery     Json?
  status      ProjectStatus @default(active)
  category    String
  location    String?
  startDate   String?
  endDate     String?
  impact      Json?
  partners    Json?
  tags        Json?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([slug])
  @@index([status])
  @@index([category])
  @@index([isActive, status])
}

enum ProjectStatus {
  active
  completed
  archived
}
